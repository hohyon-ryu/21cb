---
import '../styles/global.css';
import Breadcrumb from '../components/Breadcrumb.astro';
import { BOOKS, type BookSlug } from '../lib/books';

const {
  title,
  description,
  bookSlug = 'genesis',
  chapter = null,
  prev = null,
  next = null,
} = Astro.props as {
  title: string;
  description?: string;
  bookSlug?: BookSlug;
  chapter?: number | null;
  prev?: { url: string; label: string } | null;
  next?: { url: string; label: string } | null;
};

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
---

<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:type" content="article" />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary" />
</head>
<body>
  <Breadcrumb activeSlug={bookSlug} activeChapter={chapter} />

  <main class="shell">
    <section class="reader-wrap">
      <article class="reader">
        <slot />

        <nav class="chapter-nav" aria-label="장 이동">
          {prev ? (
            <a class="chapter-nav-link prev" href={prev.url}>
              <span class="dir">← 이전</span>
              <span class="lbl">{prev.label}</span>
            </a>
          ) : <span></span>}
          {next ? (
            <a class="chapter-nav-link next" href={next.url}>
              <span class="dir">다음 →</span>
              <span class="lbl">{next.label}</span>
            </a>
          ) : <span></span>}
        </nav>
      </article>
    </section>
  </main>
</body>
</html>
