---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import DownloadMenu from '../components/DownloadMenu.astro';
import type { BookSlug } from '../lib/books';
import { url } from '../lib/url';

const {
  title,
  description,
  bookSlug = 'genesis',
  chapter = null,
  prev = null,
  next = null,
} = Astro.props as {
  title: string;
  description?: string;
  bookSlug?: BookSlug;
  chapter?: number | null;
  prev?: { url: string; label: string } | null;
  next?: { url: string; label: string } | null;
};

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
---

<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:type" content="article" />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary" />
</head>
<body>
  <div class="shell">
    <header class="topbar">
      <div class="brand-block">
        <a class="brand" href={url('/')}>21세기 성경</a>
      </div>
      <DownloadMenu book={bookSlug} />
    </header>

    <main class="content-grid">
      <Sidebar activeSlug={bookSlug} activeChapter={chapter} />

      <section class="reader-wrap">
        <article class="reader">
          <slot />

          <nav class="chapter-nav" aria-label="장 이동">
            {prev ? (
              <a class="chapter-nav-link prev" href={prev.url}>
                <span class="dir">← 이전</span>
                <span class="lbl">{prev.label}</span>
              </a>
            ) : <span></span>}
            {next ? (
              <a class="chapter-nav-link next" href={next.url}>
                <span class="dir">다음 →</span>
                <span class="lbl">{next.label}</span>
              </a>
            ) : <span></span>}
          </nav>

          {next && (
            <div class="pull-zone" data-next-url={next.url} data-next-label={next.label}>
              <div class="pull-inner">
                <div class="pull-hint">
                  <span class="dir">
                    <span class="dir-pulling">↓ 더 당기면 다음 장</span>
                    <span class="dir-ready">↓ 놓으면 다음 장으로</span>
                  </span>
                  <span class="lbl">{next.label}</span>
                </div>
              </div>
            </div>
          )}
        </article>
      </section>
    </main>
  </div>

  <script>
    const pullZone = document.querySelector<HTMLElement>('.pull-zone');
    const nextUrl = pullZone?.dataset.nextUrl;

    if (pullZone && nextUrl) {
      const MAX = 260;          // sticky 최대 늘어나는 높이
      const CONFIRM = 80;        // held 상태에서 추가로 스크롤해야 하는 양
      const WHEEL_DAMP = 0.45;
      const TOUCH_DAMP = 0.85;
      const RELEASE_MS = 280;

      type PullState = 'normal' | 'stretching' | 'held' | 'committing';
      let stretch = 0;
      let state: PullState = 'normal';
      let confirmAccum = 0;
      let releaseTimer: number | null = null;

      function setStretch(v: number) {
        stretch = Math.max(0, Math.min(v, MAX));
        pullZone!.style.height = stretch + 'px';
        pullZone!.style.setProperty('--pull-ratio', (stretch / MAX).toString());
      }

      function setState(s: PullState) {
        state = s;
        pullZone!.classList.toggle('held', s === 'held');
        pullZone!.classList.toggle('committing', s === 'committing');
      }

      function snapBack() {
        if (state === 'committing') return;
        pullZone!.style.transition = 'height 280ms cubic-bezier(.2,.9,.3,1)';
        setStretch(0);
        setState('normal');
        confirmAccum = 0;
        window.setTimeout(() => { pullZone!.style.transition = ''; }, 320);
      }

      function commit() {
        setState('committing');
        pullZone!.style.transition = 'height 180ms ease-in';
        pullZone!.style.height = (MAX + 60) + 'px';
        window.setTimeout(() => { location.href = nextUrl; }, 200);
      }

      function scheduleRelease() {
        if (releaseTimer) clearTimeout(releaseTimer);
        releaseTimer = window.setTimeout(() => {
          if (state === 'stretching') snapBack();
        }, RELEASE_MS);
      }

      function clearReleaseTimer() {
        if (releaseTimer) {
          clearTimeout(releaseTimer);
          releaseTimer = null;
        }
      }

      function atBottom() {
        return window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 4;
      }

      // 단방향 delta를 받아 상태 머신을 진행. 가로채야 하면 true 반환
      function handleDelta(delta: number, dampening: number) {
        if (state === 'committing') return true;

        if (delta > 0) {
          if (state === 'normal') {
            if (!atBottom()) return false;
            setState('stretching');
            setStretch(stretch + delta * dampening);
            if (stretch >= MAX) setState('held');
            else scheduleRelease();
            return true;
          }
          if (state === 'stretching') {
            setStretch(stretch + delta * dampening);
            if (stretch >= MAX) {
              setState('held');
              clearReleaseTimer();
            } else {
              scheduleRelease();
            }
            return true;
          }
          if (state === 'held') {
            confirmAccum += delta;
            if (confirmAccum >= CONFIRM) commit();
            return true;
          }
        }

        if (delta < 0) {
          if (state === 'held') {
            snapBack();
            return true;
          }
          if (state === 'stretching') {
            const next = stretch + delta * dampening;
            if (next <= 0) snapBack();
            else {
              setStretch(next);
              scheduleRelease();
            }
            return true;
          }
        }

        return false;
      }

      window.addEventListener(
        'wheel',
        (e: WheelEvent) => {
          if (handleDelta(e.deltaY, WHEEL_DAMP)) e.preventDefault();
        },
        { passive: false }
      );

      // Touch — 매 프레임마다 직전 touch 위치와의 증분 delta
      let lastTouchY: number | null = null;
      window.addEventListener(
        'touchstart',
        (e: TouchEvent) => {
          if (state === 'committing') return;
          lastTouchY = e.touches[0]?.clientY ?? null;
        },
        { passive: true }
      );
      window.addEventListener(
        'touchmove',
        (e: TouchEvent) => {
          if (lastTouchY === null) return;
          const y = e.touches[0]?.clientY;
          if (y === undefined) return;
          const delta = lastTouchY - y;
          lastTouchY = y;
          if (handleDelta(delta, TOUCH_DAMP) && e.cancelable) {
            e.preventDefault();
          }
        },
        { passive: false }
      );
      window.addEventListener('touchend', () => {
        lastTouchY = null;
        if (state === 'stretching') snapBack();
      });
    }
  </script>
</body>
</html>
