---
import '../styles/global.css';
import Sidebar from '../components/Sidebar.astro';
import DownloadMenu from '../components/DownloadMenu.astro';
import { BOOKS, type BookSlug } from '../lib/books';
import { url } from '../lib/url';

const {
  title,
  description,
  bookSlug = 'genesis',
  chapter = null,
  prev = null,
  next = null,
} = Astro.props as {
  title: string;
  description?: string;
  bookSlug?: BookSlug;
  chapter?: number | null;
  prev?: { url: string; label: string } | null;
  next?: { url: string; label: string } | null;
};

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const bookName = BOOKS[bookSlug].name;
const contextLabel = chapter ? `${bookName} ${chapter}장` : bookName;
---

<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  {description && <meta name="description" content={description} />}
  <link rel="canonical" href={canonical} />
  <meta property="og:title" content={title} />
  {description && <meta property="og:description" content={description} />}
  <meta property="og:type" content="article" />
  <meta property="og:url" content={canonical} />
  <meta name="twitter:card" content="summary" />
</head>
<body>
  <div class="dl-float">
    <DownloadMenu book={bookSlug} />
  </div>
  <div class="shell">
    <main class="content-grid">
      <Sidebar activeSlug={bookSlug} activeChapter={chapter} />

      <section class="reader-wrap">
        <article class="reader">
          <slot />

          <nav class="chapter-nav" aria-label="장 이동">
            {prev ? (
              <a class="chapter-nav-link prev" href={prev.url}>
                <span class="dir">← 이전</span>
                <span class="lbl">{prev.label}</span>
              </a>
            ) : <span></span>}
            {next ? (
              <a class="chapter-nav-link next" href={next.url}>
                <span class="dir">다음 →</span>
                <span class="lbl">{next.label}</span>
              </a>
            ) : <span></span>}
          </nav>

          {next && (
            <div class="pull-zone" data-next-url={next.url} data-next-label={next.label}>
              <div class="pull-inner">
                <div class="pull-hint">
                  <span class="dir">
                    <span class="dir-pulling">↓ 당겨서 다음 장</span>
                    <span class="dir-armed">↑ 놓으면 다음 장</span>
                  </span>
                  <span class="lbl">{next.label}</span>
                </div>
              </div>
            </div>
          )}
        </article>
      </section>
    </main>
  </div>

  <script>

    const pullZone = document.querySelector<HTMLElement>('.pull-zone');
    const nextUrl = pullZone?.dataset.nextUrl;

    if (pullZone && nextUrl) {
      // iOS pull-to-refresh 스타일 — 단일 제스처. 끝까지 당겨서 임계점 넘기면 armed 상태,
      // 손 떼면(또는 휠 멈추면) trigger / 스냅백.
      const TRIGGER = 120;
      const MAX = 200;
      const WHEEL_DAMP = 0.45;
      const TOUCH_DAMP = 0.95;
      const WHEEL_RELEASE_MS = 90;
      const WHEEL_ACTIVE_DELTA = 12;  // 이 이하의 deltaY는 inertia 꼬리로 간주, 타이머 리셋 X

      let stretch = 0;
      let armed = false;
      let committing = false;
      let touching = false;
      let wheelReleaseTimer: number | null = null;

      function applyResistance(target: number) {
        // target이 MAX를 초과하지 않게, 끝부분 부드럽게 둔화
        if (target <= 0) return 0;
        if (target >= MAX) return MAX;
        return target;
      }

      function setStretch(v: number) {
        stretch = applyResistance(v);
        pullZone!.style.height = stretch + 'px';
        pullZone!.style.setProperty('--pull-ratio', Math.min(stretch / TRIGGER, 1).toString());
        const newArmed = stretch >= TRIGGER;
        if (newArmed !== armed) {
          armed = newArmed;
          pullZone!.classList.toggle('armed', armed);
        }
      }

      function snapBack() {
        if (committing) return;
        pullZone!.style.transition = 'height 280ms cubic-bezier(.2,.9,.3,1)';
        setStretch(0);
        window.setTimeout(() => { pullZone!.style.transition = ''; }, 320);
      }

      function commit() {
        if (committing) return;
        committing = true;
        pullZone!.classList.add('committing');
        pullZone!.style.transition = 'height 160ms ease-in';
        pullZone!.style.height = (TRIGGER + 40) + 'px';
        window.setTimeout(() => { location.href = nextUrl; }, 180);
      }

      function release() {
        if (committing) return;
        if (armed) commit();
        else snapBack();
      }

      function atBottom() {
        return window.scrollY + window.innerHeight >= document.documentElement.scrollHeight - 4;
      }

      function handleDelta(delta: number, dampening: number) {
        if (committing) return true;
        // 활성 조건: 화면 끝에서 아래로 스크롤하거나 이미 stretch 상태인 경우
        const active = stretch > 0 || (delta > 0 && atBottom());
        if (!active) return false;
        const next = stretch + delta * dampening;
        if (next <= 0) {
          // 위로 끝까지 풀면 끝
          setStretch(0);
        } else {
          setStretch(next);
        }
        return true;
      }

      // Wheel — 활성 스크롤만 release timer 리셋, inertia 꼬리는 무시 → 손 떼자마자 release
      window.addEventListener(
        'wheel',
        (e: WheelEvent) => {
          if (touching) return;
          if (handleDelta(e.deltaY, WHEEL_DAMP)) e.preventDefault();
          if (stretch > 0 && Math.abs(e.deltaY) >= WHEEL_ACTIVE_DELTA) {
            if (wheelReleaseTimer) clearTimeout(wheelReleaseTimer);
            wheelReleaseTimer = window.setTimeout(release, WHEEL_RELEASE_MS);
          }
        },
        { passive: false }
      );

      // Touch — touchend 시점에 release
      let lastTouchY: number | null = null;
      window.addEventListener(
        'touchstart',
        (e: TouchEvent) => {
          if (committing) return;
          touching = true;
          lastTouchY = e.touches[0]?.clientY ?? null;
        },
        { passive: true }
      );
      window.addEventListener(
        'touchmove',
        (e: TouchEvent) => {
          if (lastTouchY === null) return;
          const y = e.touches[0]?.clientY;
          if (y === undefined) return;
          const delta = lastTouchY - y;
          lastTouchY = y;
          if (handleDelta(delta, TOUCH_DAMP) && e.cancelable) {
            e.preventDefault();
          }
        },
        { passive: false }
      );
      window.addEventListener('touchend', () => {
        touching = false;
        lastTouchY = null;
        release();
      });
    }
  </script>
</body>
</html>
