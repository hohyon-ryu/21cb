---
import '../styles/global.css';
import KrvBreadcrumb from '../components/KrvBreadcrumb.astro';
import { BOOKS, type BookSlug } from '../lib/books';
import { url } from '../lib/url';

const {
  title,
  description,
  bookSlug = 'genesis',
  chapter = null,
  prev = null,
  next = null,
} = Astro.props as {
  title: string;
  description?: string;
  bookSlug?: BookSlug;
  chapter?: number | null;
  prev?: { url: string; label: string } | null;
  next?: { url: string; label: string } | null;
};

const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).toString();
const bookName = BOOKS[bookSlug].name;
const ogDescription = description ?? `개역한글 — ${bookName} ${chapter ?? ''}장.`;
---

<!doctype html>
<html lang="ko">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={ogDescription} />
  <meta name="theme-color" content="#fbf6ec" />
  <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
  <link rel="canonical" href={canonical} />
</head>
<body>
  <KrvBreadcrumb activeSlug={bookSlug} activeChapter={chapter} />

  <main class="shell">
    <section class="reader-wrap">
      <article class="reader">
        <slot />

        <nav class="chapter-nav" aria-label="장 이동">
          {prev ? (
            <a class="chapter-nav-link prev" href={prev.url}>
              <span class="dir">← 이전</span>
              <span class="lbl">{prev.label}</span>
            </a>
          ) : <span></span>}
          {next ? (
            <a class="chapter-nav-link next" href={next.url}>
              <span class="dir">다음 →</span>
              <span class="lbl">{next.label}</span>
            </a>
          ) : <span></span>}
        </nav>

        <footer class="krv-credit">
          <small>본문: 『성경전서 개역한글판』 (1961, 대한성서공회). Public Domain.</small>
        </footer>
      </article>
    </section>
  </main>
</body>
</html>

<style>
  .krv-credit {
    margin: 3em 0 0;
    padding-top: 1em;
    border-top: 1px dashed var(--line);
    text-align: center;
    color: var(--muted);
    font-family: 'Pretendard', 'SUIT', sans-serif;
    font-size: 0.78rem;
  }
</style>
