---
import { getCollection } from 'astro:content';
import { BOOKS, BOOK_ORDER, type BookSlug } from '../lib/books';
import { url } from '../lib/url';
import DownloadMenu from './DownloadMenu.astro';

const { activeSlug = 'genesis', activeChapter = null } = Astro.props as {
  activeSlug?: BookSlug;
  activeChapter?: number | null;
};

const all: Record<BookSlug, { chapter: number; title: string }[]> = {
  genesis: [],
  exodus: [],
};

for (const slug of BOOK_ORDER) {
  const items = await getCollection(slug);
  all[slug] = items
    .map((it) => ({ chapter: it.data.chapter, title: it.data.title }))
    .sort((a, b) => a.chapter - b.chapter);
}

const activeChapters = all[activeSlug] ?? [];
const activeBookName = BOOKS[activeSlug].name;
const currentChapterTitle =
  activeChapters.find((c) => c.chapter === activeChapter)?.title ?? '';
const currentChapterLabel = activeChapter
  ? `${activeChapter}장 · ${currentChapterTitle}`
  : '장 선택';
---

<aside class="side" aria-label="성경 네비게이터">
  <a class="brand" href={url('/')}>
    <span class="b-era">21세기</span>
    <span class="b-rule" aria-hidden="true"></span>
    <span class="b-name">성<span class="b-gap"></span>경</span>
  </a>

  <div class="side-actions">
    <DownloadMenu book={activeSlug} />
  </div>

  <details class="picker book-picker">
    <summary>
      <span class="picker-label">책</span>
      <span class="picker-value">{activeBookName}</span>
      <span class="picker-caret" aria-hidden="true">▾</span>
    </summary>
    <ul class="picker-list" role="menu">
      {BOOK_ORDER.map((slug) => {
        const written = all[slug].length;
        const total = BOOKS[slug].total;
        const cls = slug === activeSlug ? 'active' : '';
        const href = written > 0 ? url(`/${slug}/${all[slug][0].chapter}`) : url(`/${slug}`);
        return (
          <li>
            <a class={cls} href={href} role="menuitem">
              <span class="pi-name">{BOOKS[slug].name}</span>
              <span class="pi-meta">{written}/{total}</span>
            </a>
          </li>
        );
      })}
    </ul>
  </details>

  {activeChapters.length > 0 && (
    <details class="picker chapter-picker">
      <summary>
        <span class="picker-label">장</span>
        <span class="picker-value">{currentChapterLabel}</span>
        <span class="picker-caret" aria-hidden="true">▾</span>
      </summary>
      <ul class="picker-list scroll" role="menu">
        {activeChapters.map((ch) => (
          <li>
            <a
              class={ch.chapter === activeChapter ? 'active' : ''}
              href={url(`/${activeSlug}/${ch.chapter}`)}
              role="menuitem"
            >
              <span class="ch-num">{ch.chapter}</span>
              <span class="ch-title">{ch.title}</span>
            </a>
          </li>
        ))}
      </ul>
    </details>
  )}
</aside>
