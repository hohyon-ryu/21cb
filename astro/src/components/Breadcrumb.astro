---
import { getCollection } from 'astro:content';
import { BOOKS, BOOK_ORDER, type BookSlug } from '../lib/books';
import { url } from '../lib/url';
import DownloadMenu from './DownloadMenu.astro';

const { activeSlug = 'genesis', activeChapter = null } = Astro.props as {
  activeSlug?: BookSlug;
  activeChapter?: number | null;
};

const all: Record<BookSlug, { chapter: number; title: string }[]> = {
  genesis: [],
  exodus: [],
  leviticus: [],
  numbers: [],
  deuteronomy: [],
  joshua: [],
  judges: [],
  ruth: [],
  samuel1: [],
  samuel2: [],
  kings1: [],
  kings2: [],
  chronicles1: [],
  chronicles2: [],
  ezra: [],
  nehemiah: [],
  esther: [],
  job: [],
  proverbs: [],
  ecclesiastes: [],
  song: [],
  isaiah: [],
  jeremiah: [],
  lamentations: [],
  ezekiel: [],
  daniel: [],
  hosea: [],
  joel: [],
  amos: [],
  obadiah: [],
  jonah: [],
  micah: [],
  nahum: [],
  habakkuk: [],
  zephaniah: [],
  haggai: [],
  zechariah: [],
  malachi: [],
};
for (const slug of BOOK_ORDER) {
  const items = await getCollection(slug);
  all[slug] = items
    .map((it) => ({ chapter: it.data.chapter, title: it.data.title }))
    .sort((a, b) => a.chapter - b.chapter);
}

const activeChapters = all[activeSlug] ?? [];
const activeBookName = BOOKS[activeSlug].name;
const activeChapterTitle =
  activeChapters.find((c) => c.chapter === activeChapter)?.title ?? '';
const chapterLabel = activeChapter
  ? `${activeChapter}장 — ${activeChapterTitle}`
  : '장 선택';
---

<header class="topbar" role="banner">
 <div class="topbar-inner">
  <nav class="crumb" aria-label="네비게이션">
    <a class="crumb-brand" href={url('/genesis/1')} aria-label="21세기 성경 홈">
      <span class="crumb-brand-text">21세기 성경</span>
      <span class="crumb-brand-icon" aria-hidden="true">📖</span>
    </a>
    <span class="crumb-sep" aria-hidden="true">›</span>

    <details class="crumb-picker">
      <summary>
        <span class="crumb-text">{activeBookName}</span>
      </summary>
      <ul class="crumb-menu" role="menu">
        {BOOK_ORDER.map((slug) => {
          const written = all[slug].length;
          const cls = slug === activeSlug ? 'active' : '';
          const href = written > 0 ? url(`/${slug}/${all[slug][0].chapter}`) : url(`/${slug}`);
          return (
            <li>
              <a class={cls} href={href} role="menuitem">
                <span class="cm-name">{BOOKS[slug].name}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </details>

    {activeChapters.length > 0 && activeChapter !== null && (
      <>
        <span class="crumb-sep" aria-hidden="true">›</span>
        <details class="crumb-picker chapter">
          <summary>
            <span class="crumb-text">{chapterLabel}</span>
          </summary>
          <ul class="crumb-menu scroll" role="menu">
            {activeChapters.map((ch) => (
              <li>
                <a
                  class={ch.chapter === activeChapter ? 'active' : ''}
                  href={url(`/${activeSlug}/${ch.chapter}`)}
                  role="menuitem"
                >
                  <span class="cm-num">{ch.chapter}</span>
                  <span class="cm-title">{ch.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </details>
      </>
    )}
  </nav>

  <div class="topbar-actions">
    <DownloadMenu book={activeSlug} />
  </div>
 </div>
</header>

<script>
  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    document.querySelectorAll<HTMLDetailsElement>('details.crumb-picker[open], details.dl-menu[open]').forEach((d) => {
      if (!d.contains(target)) d.open = false;
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    document.querySelectorAll<HTMLDetailsElement>('details.crumb-picker[open], details.dl-menu[open]').forEach((d) => {
      d.open = false;
    });
  });
</script>
