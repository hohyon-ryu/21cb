---
import { getCollection } from 'astro:content';
import { BOOKS, BOOK_ORDER, OT_BOOKS, NT_BOOKS, APPENDIX_BOOKS, type BookSlug } from '../lib/books';
import { url } from '../lib/url';
import DownloadMenu from './DownloadMenu.astro';

const { activeSlug = 'genesis', activeChapter = null } = Astro.props as {
  activeSlug?: BookSlug;
  activeChapter?: number | null;
};

const all: Record<BookSlug, { chapter: number; title: string; emoji: string }[]> = {
  genesis: [],
  exodus: [],
  leviticus: [],
  numbers: [],
  deuteronomy: [],
  joshua: [],
  judges: [],
  ruth: [],
  samuel1: [],
  samuel2: [],
  kings1: [],
  kings2: [],
  chronicles1: [],
  chronicles2: [],
  ezra: [],
  nehemiah: [],
  esther: [],
  job: [],
  psalms: [],
  proverbs: [],
  ecclesiastes: [],
  song: [],
  isaiah: [],
  jeremiah: [],
  lamentations: [],
  ezekiel: [],
  daniel: [],
  hosea: [],
  joel: [],
  amos: [],
  obadiah: [],
  jonah: [],
  micah: [],
  nahum: [],
  habakkuk: [],
  zephaniah: [],
  haggai: [],
  zechariah: [],
  malachi: [],
  matthew: [],
  mark: [],
  luke: [],
  john: [],
  acts: [],
  romans: [],
  corinthians1: [],
  corinthians2: [],
  galatians: [],
  ephesians: [],
  philippians: [],
  colossians: [],
  thessalonians1: [],
  thessalonians2: [],
  timothy1: [],
  timothy2: [],
  titus: [],
  philemon: [],
  hebrews: [],
  james: [],
  peter1: [],
  peter2: [],
  john1: [],
  john2: [],
  john3: [],
  jude: [],
  revelation: [],
  harmony: [],
};
for (const slug of BOOK_ORDER) {
  const items = await getCollection(slug);
  all[slug] = items
    .map((it) => ({ chapter: it.data.chapter, title: it.data.title, emoji: it.data.emoji ?? '' }))
    .sort((a, b) => a.chapter - b.chapter);
}

const activeChapters = all[activeSlug] ?? [];
const activeBookName = BOOKS[activeSlug].name;
const activeBookEmoji = BOOKS[activeSlug].emoji;
const activeChapterEntry = activeChapters.find((c) => c.chapter === activeChapter);
const activeChapterTitle = activeChapterEntry?.title ?? '';
const activeChapterEmoji = activeChapterEntry?.emoji ?? '';
const chapterLabel = activeChapter
  ? `${activeChapter}장 — ${activeChapterTitle}`
  : '장 선택';
---

<header class="topbar" role="banner">
 <div class="topbar-inner">
  <nav class="crumb" aria-label="네비게이션">
    <details class="crumb-picker brand">
      <summary aria-label="버전 선택">
        <span class="crumb-emoji" aria-hidden="true">📖</span>
        <span class="crumb-text">21세기 성경</span>
      </summary>
      <ul class="crumb-menu" role="menu">
        <li>
          <a class="active" href={url(`/${activeSlug}/${activeChapter ?? 1}`)} role="menuitem">
            <span class="cm-emoji" aria-hidden="true">📖</span>
            <span class="cm-name">21세기 성경</span>
          </a>
        </li>
        <li>
          <a href={url(`/kidsb/${activeSlug}/${activeChapter ?? 1}`)} role="menuitem">
            <span class="cm-emoji" aria-hidden="true">🌱</span>
            <span class="cm-name">어린이 성경</span>
          </a>
        </li>
        <li>
          <a href={url(`/krv/${activeSlug}/${activeChapter ?? 1}`)} role="menuitem">
            <span class="cm-emoji" aria-hidden="true">📜</span>
            <span class="cm-name">개역한글</span>
          </a>
        </li>
      </ul>
    </details>

    <details class="crumb-picker">
      <summary>
        <span class="crumb-emoji" aria-hidden="true">{activeBookEmoji}</span>
        <span class="crumb-text">{activeBookName}</span>
      </summary>
      <ul class="crumb-menu scroll" role="menu">
        <li class="cm-section" aria-hidden="true">오랜 약속</li>
        {OT_BOOKS.map((slug) => {
          const written = all[slug].length;
          const cls = slug === activeSlug ? 'active' : '';
          const href = written > 0 ? url(`/${slug}/${all[slug][0].chapter}`) : url(`/${slug}`);
          return (
            <li>
              <a class={cls} href={href} role="menuitem">
                <span class="cm-emoji" aria-hidden="true">{BOOKS[slug].emoji}</span>
                <span class="cm-name">{BOOKS[slug].name}</span>
              </a>
            </li>
          );
        })}
        <li class="cm-section" aria-hidden="true">새 약속</li>
        {NT_BOOKS.map((slug) => {
          const written = all[slug].length;
          const cls = slug === activeSlug ? 'active' : '';
          const href = written > 0 ? url(`/${slug}/${all[slug][0].chapter}`) : url(`/${slug}`);
          return (
            <li>
              <a class={cls} href={href} role="menuitem">
                <span class="cm-emoji" aria-hidden="true">{BOOKS[slug].emoji}</span>
                <span class="cm-name">{BOOKS[slug].name}</span>
              </a>
            </li>
          );
        })}
        <li class="cm-section cm-section-appendix" aria-hidden="true">부록 — 새로 쓴 책</li>
        {APPENDIX_BOOKS.map((slug) => {
          const written = all[slug].length;
          const cls = slug === activeSlug ? 'active' : '';
          const href = written > 0 ? url(`/${slug}/${all[slug][0].chapter}`) : url(`/${slug}`);
          return (
            <li>
              <a class={cls} href={href} role="menuitem">
                <span class="cm-emoji" aria-hidden="true">{BOOKS[slug].emoji}</span>
                <span class="cm-name">{BOOKS[slug].name}</span>
              </a>
            </li>
          );
        })}
      </ul>
    </details>

    {activeChapters.length > 0 && activeChapter !== null && (
      <>
        <details class="crumb-picker chapter">
          <summary>
            <span class="crumb-emoji" aria-hidden="true">{activeChapterEmoji}</span>
            <span class="crumb-text">{chapterLabel}</span>
          </summary>
          <ul class="crumb-menu scroll" role="menu">
            {activeChapters.map((ch) => (
              <li>
                <a
                  class={ch.chapter === activeChapter ? 'active' : ''}
                  href={url(`/${activeSlug}/${ch.chapter}`)}
                  role="menuitem"
                >
                  <span class="cm-num">{ch.chapter}</span>
                  <span class="cm-emoji" aria-hidden="true">{ch.emoji}</span>
                  <span class="cm-title">{ch.title}</span>
                </a>
              </li>
            ))}
          </ul>
        </details>
      </>
    )}
  </nav>

  <div class="topbar-actions">
    <DownloadMenu book={activeSlug} />
  </div>
 </div>
</header>

<script>
  document.addEventListener('click', (e) => {
    const target = e.target as Node;
    document.querySelectorAll<HTMLDetailsElement>('details.crumb-picker[open], details.dl-menu[open]').forEach((d) => {
      if (!d.contains(target)) d.open = false;
    });
  });
  document.addEventListener('keydown', (e) => {
    if (e.key !== 'Escape') return;
    document.querySelectorAll<HTMLDetailsElement>('details.crumb-picker[open], details.dl-menu[open]').forEach((d) => {
      d.open = false;
    });
  });
</script>
