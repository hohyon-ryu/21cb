---
import { url } from '../lib/url';

const { book = 'genesis' } = Astro.props as { book?: string };

const FILES: Record<string, { epub?: string; pdf?: string }> = {
  genesis: { epub: '/files/genesis.epub', pdf: '/files/genesis.pdf' },
  exodus: { epub: '/files/exodus.epub' },
  leviticus: { epub: '/files/leviticus.epub' },
  numbers: { epub: '/files/numbers.epub' },
  deuteronomy: { epub: '/files/deuteronomy.epub' },
  joshua: { epub: '/files/joshua.epub' },
  judges: { epub: '/files/judges.epub' },
  ruth: { epub: '/files/ruth.epub' },
  samuel1: { epub: '/files/samuel1.epub' },
  samuel2: { epub: '/files/samuel2.epub' },
  kings1: { epub: '/files/kings1.epub' },
  kings2: { epub: '/files/kings2.epub' },
  chronicles1: { epub: '/files/chronicles1.epub' },
  chronicles2: { epub: '/files/chronicles2.epub' },
};

const files = FILES[book] ?? {};
const hasAny = !!(files.epub || files.pdf);
---

{hasAny && (
  <details class="dl-menu">
    <summary class="dl-trigger" aria-label="내려받기" title="내려받기">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 4v12" />
        <path d="m6 11 6 6 6-6" />
        <path d="M5 20h14" />
      </svg>
    </summary>
    <div class="dl-list" role="menu">
      {files.epub && <a role="menuitem" href={url(files.epub)} download>전자책 (EPUB)</a>}
      {files.pdf && <a role="menuitem" href={url(files.pdf)} download>PDF</a>}
    </div>
  </details>
)}
