---
import { url } from '../lib/url';
import { BOOKS, type BookSlug } from '../lib/books';

const { book = 'genesis' } = Astro.props as { book?: BookSlug };
const bookName = BOOKS[book]?.name ?? '';

const FILES: Record<string, { epub?: string; pdf?: string }> = {
  genesis: { epub: '/files/genesis.epub', pdf: '/files/genesis.pdf' },
  exodus: { epub: '/files/exodus.epub' },
  leviticus: { epub: '/files/leviticus.epub' },
  numbers: { epub: '/files/numbers.epub' },
  deuteronomy: { epub: '/files/deuteronomy.epub' },
  joshua: { epub: '/files/joshua.epub' },
  judges: { epub: '/files/judges.epub' },
  ruth: { epub: '/files/ruth.epub' },
  samuel1: { epub: '/files/samuel1.epub' },
  samuel2: { epub: '/files/samuel2.epub' },
  kings1: { epub: '/files/kings1.epub' },
  kings2: { epub: '/files/kings2.epub' },
  chronicles1: { epub: '/files/chronicles1.epub' },
  chronicles2: { epub: '/files/chronicles2.epub' },
  ezra: { epub: '/files/ezra.epub' },
  nehemiah: { epub: '/files/nehemiah.epub' },
  esther: { epub: '/files/esther.epub' },
  job: { epub: '/files/job.epub' },
  psalms: { epub: '/files/psalms.epub' },
  proverbs: { epub: '/files/proverbs.epub' },
  ecclesiastes: { epub: '/files/ecclesiastes.epub' },
  song: { epub: '/files/song.epub' },
  isaiah: { epub: '/files/isaiah.epub' },
  jeremiah: { epub: '/files/jeremiah.epub' },
  lamentations: { epub: '/files/lamentations.epub' },
  ezekiel: { epub: '/files/ezekiel.epub' },
  daniel: { epub: '/files/daniel.epub' },
  hosea: { epub: '/files/hosea.epub' },
  joel: { epub: '/files/joel.epub' },
  amos: { epub: '/files/amos.epub' },
  obadiah: { epub: '/files/obadiah.epub' },
  jonah: { epub: '/files/jonah.epub' },
  micah: { epub: '/files/micah.epub' },
  nahum: { epub: '/files/nahum.epub' },
  habakkuk: { epub: '/files/habakkuk.epub' },
  zephaniah: { epub: '/files/zephaniah.epub' },
  haggai: { epub: '/files/haggai.epub' },
  zechariah: { epub: '/files/zechariah.epub' },
  malachi: { epub: '/files/malachi.epub' },
  matthew: { epub: '/files/matthew.epub' },
  mark: { epub: '/files/mark.epub' },
  luke: { epub: '/files/luke.epub' },
  john: { epub: '/files/john.epub' },
  acts: { epub: '/files/acts.epub' },
  romans: { epub: '/files/romans.epub' },
  corinthians1: { epub: '/files/corinthians1.epub' },
  corinthians2: { epub: '/files/corinthians2.epub' },
  galatians: { epub: '/files/galatians.epub' },
  ephesians: { epub: '/files/ephesians.epub' },
  philippians: { epub: '/files/philippians.epub' },
  colossians: { epub: '/files/colossians.epub' },
  thessalonians1: { epub: '/files/thessalonians1.epub' },
  thessalonians2: { epub: '/files/thessalonians2.epub' },
  timothy1: { epub: '/files/timothy1.epub' },
  timothy2: { epub: '/files/timothy2.epub' },
  titus: { epub: '/files/titus.epub' },
  philemon: { epub: '/files/philemon.epub' },
  hebrews: { epub: '/files/hebrews.epub' },
  james: { epub: '/files/james.epub' },
  peter1: { epub: '/files/peter1.epub' },
  peter2: { epub: '/files/peter2.epub' },
  john1: { epub: '/files/john1.epub' },
  john2: { epub: '/files/john2.epub' },
  john3: { epub: '/files/john3.epub' },
  jude: { epub: '/files/jude.epub' },
  revelation: { epub: '/files/revelation.epub' },
};

const files = FILES[book] ?? {};
const hasAny = true;
---

{hasAny && (
  <details class="dl-menu">
    <summary class="dl-trigger" aria-label="내려받기" title="내려받기">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M12 4v12" />
        <path d="m6 11 6 6 6-6" />
        <path d="M5 20h14" />
      </svg>
    </summary>
    <div class="dl-list" role="menu">
      {files.epub && <a role="menuitem" href={url(files.epub)} download>{bookName} EPUB</a>}
      {files.pdf && <a role="menuitem" href={url(files.pdf)} download>{bookName} PDF</a>}
      <a role="menuitem" href={url('/files/full.epub')} download class="dl-full">66권 전체 EPUB</a>
    </div>
  </details>
)}
