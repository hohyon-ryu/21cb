---
import { url } from '../lib/url';
const target = url('/genesis/1');
const targetUrl = new URL(target, Astro.site ?? Astro.url).toString();
const ogImage = new URL(url('/assets/og/21cb-og.jpg'), Astro.site ?? Astro.url).toString();
const title = '21세기 성경 — 현대 한국어로 다시 읽는 성경';
const description = '구약·신약 66권을 21세기 한국어로 다시 옮긴 성경. 본문, 부연 설명, 고고학·세 종교 해석 비교까지 한 화면에서.';
const ogImageAlt = '21세기 성경 — 구약 39권 + 신약 27권 합본';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: '21세기 성경',
  alternateName: '21cb',
  url: targetUrl,
  inLanguage: 'ko-KR',
  description,
  image: ogImage,
};
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={targetUrl} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate icon" href={url('/favicon.ico')} />

    <meta property="og:site_name" content="21세기 성경" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={targetUrl} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <script set:html={`location.replace(${JSON.stringify(target)})`} />
  </head>
  <body></body>
</html>
