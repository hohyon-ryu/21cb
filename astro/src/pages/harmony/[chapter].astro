---
import { getCollection, render } from 'astro:content';
import Reader from '../../layouts/Reader.astro';
import ChapterTitle from '../../components/ChapterTitle.astro';
import { BOOKS } from '../../lib/books';
import { url } from '../../lib/url';

export async function getStaticPaths() {
  const items = (await getCollection('harmony')).sort(
    (a, b) => a.data.chapter - b.data.chapter
  );
  return items.map((entry, idx) => ({
    params: { chapter: String(entry.data.chapter) },
    props: {
      entry,
      prev: items[idx - 1]
        ? { chapter: items[idx - 1].data.chapter, title: items[idx - 1].data.title }
        : null,
      next: items[idx + 1]
        ? { chapter: items[idx + 1].data.chapter, title: items[idx + 1].data.title }
        : null,
    },
  }));
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
const bookName = BOOKS.harmony.name;
const slug = 'harmony';
const { chapter, title, emoji } = entry.data;
const seoTitle = `${bookName} ${chapter}장 — ${title} | 21세기 성경`;
const desc = `21세기 성경 부록 — 4복음서를 새롭게 통합한 재서술. ${bookName} ${chapter}장: ${title}.`;
---

<Reader
  title={seoTitle}
  description={desc}
  bookSlug={slug}
  chapter={chapter}
  prev={prev ? { url: url(`/${slug}/${prev.chapter}`), label: `${prev.chapter}장 · ${prev.title}` } : null}
  next={next ? { url: url(`/${slug}/${next.chapter}`), label: `${next.chapter}장 · ${next.title}` } : null}
>
  <aside class="harmony-banner" aria-label="부록 안내">
    <strong>부록 — 새로 쓴 책</strong>
    <span>이 책은 4복음서(마태·마가·누가·요한)의 내용을 시간 순서로 통합해 새롭게 서술한 글이다. 원본 정경에 속하지 않는다.</span>
  </aside>
  <ChapterTitle bookName={bookName} chapter={chapter} title={title} emoji={emoji} />
  <Content />
</Reader>
