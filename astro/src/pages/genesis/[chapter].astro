---
import { getCollection, render } from 'astro:content';
import Reader from '../../layouts/Reader.astro';
import ChapterTitle from '../../components/ChapterTitle.astro';
import { BOOKS } from '../../lib/books';
import { url } from '../../lib/url';
import {
  HERO_OVERRIDES_GENESIS,
  extractMapFigure,
  getFallbackMap,
  type ChapterImage,
} from '../../lib/chapter-images';

export async function getStaticPaths() {
  const items = (await getCollection('genesis')).sort(
    (a, b) => a.data.chapter - b.data.chapter
  );

  const anchors = items
    .map((entry) => ({ chapter: entry.data.chapter, image: extractMapFigure(entry.body) }))
    .filter((it): it is { chapter: number; image: ChapterImage } => Boolean(it.image));

  return items.map((entry, idx) => ({
    params: { chapter: String(entry.data.chapter) },
    props: {
      entry,
      prev: items[idx - 1]
        ? { chapter: items[idx - 1].data.chapter, title: items[idx - 1].data.title }
        : null,
      next: items[idx + 1]
        ? { chapter: items[idx + 1].data.chapter, title: items[idx + 1].data.title }
        : null,
      ownMap: extractMapFigure(entry.body),
      heroMap: HERO_OVERRIDES_GENESIS[entry.data.chapter] ?? getFallbackMap(entry.data.chapter, anchors),
    },
  }));
}

const { entry, prev, next, ownMap, heroMap } = Astro.props as {
  entry: Awaited<ReturnType<typeof getCollection<'genesis'>>>[number];
  prev: { chapter: number; title: string } | null;
  next: { chapter: number; title: string } | null;
  ownMap: ChapterImage | null;
  heroMap: ChapterImage | null;
};
const { Content } = await render(entry);
const bookName = BOOKS.genesis.name;
const slug = 'genesis';
const { chapter, title, emoji } = entry.data;
const seoTitle = `${bookName} ${chapter}장 — ${title} | 21세기 성경`;
const desc = `21세기에 읽는 성경. ${bookName} ${chapter}장: ${title}. 본문, 부연 설명, 고고학·세 종교 해석 비교.`;
---

<Reader
  title={seoTitle}
  description={desc}
  bookSlug={slug}
  chapter={chapter}
  prev={prev ? { url: url(`/${slug}/${prev.chapter}`), label: `${prev.chapter}장 · ${prev.title}` } : null}
  next={next ? { url: url(`/${slug}/${next.chapter}`), label: `${next.chapter}장 · ${next.title}` } : null}
>
  <ChapterTitle bookName={bookName} chapter={chapter} title={title} emoji={emoji} />
  {!ownMap && heroMap && (
    <div class="map-figure">
      <img src={heroMap.src} alt={heroMap.alt} loading="lazy" />
      <p class="map-caption">{heroMap.caption}</p>
    </div>
  )}
  <Content />
</Reader>
