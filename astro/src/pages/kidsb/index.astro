---
import { url } from '../../lib/url';

const target = url('/kidsb/genesis/1');
const targetUrl = new URL(target, Astro.site ?? Astro.url).toString();
const ogImage = new URL(url('/assets/og/kidsb-og.jpg'), Astro.site ?? Astro.url).toString();
const title = '어린이 성경 — 초등학생을 위한 쉬운 21세기 성경';
const description = '초등학생이 읽기 쉬운 어린이 성경. 구약과 신약 이야기를 쉬운 말과 친절한 설명으로 읽을 수 있습니다.';
const ogImageAlt = '어린이 성경 — 초등학생을 위한 쉬운 번역본';

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: '어린이 성경',
  alternateName: '21세기 어린이 성경',
  url: targetUrl,
  inLanguage: 'ko-KR',
  description,
  image: ogImage,
  audience: {
    '@type': 'EducationalAudience',
    educationalRole: 'student',
  },
};
---
<!doctype html>
<html lang="ko">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <link rel="canonical" href={targetUrl} />
    <link rel="icon" href={url('/favicon.svg')} type="image/svg+xml" />
    <link rel="alternate icon" href={url('/favicon.ico')} />

    <meta property="og:site_name" content="어린이 성경" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={targetUrl} />
    <meta property="og:locale" content="ko_KR" />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <script set:html={`location.replace(${JSON.stringify(target)})`} />
  </head>
  <body></body>
</html>
